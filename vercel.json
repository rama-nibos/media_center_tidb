{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/sync-berita",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api-hst/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}